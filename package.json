{
  "name": "@repo/stark",
  "private": true,
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=24.11.0"
  },
  "workspaces": [
    "apps/*",
    "package/*"
  ],
  "scripts": {
    "dev": "npm run build:package && turbo run dev storybook",
    "storybook": "npm run build:package && npm run storybook --workspace=storybook",
    "dev:sandbox": "npm run build:package && npm run dev --workspace=sandbox",
    "build": "turbo run build",
    "build:package": "npm run build --workspace=stark-lib",
    "build:sandbox": "turbo run build --filter=sandbox",
    "build:storybook": "turbo run build --filter=storybook",
    "typecheck": "npm run build:package && npm run typecheck --workspaces --if-present && tsc -p tsconfig.tooling.json",
    "test": "playwright test",
    "test:update": "npm run build:package && playwright test --update-snapshots",
    "test:serve": "vite --config tests/vite.config.ts",
    "check": "npm run typecheck && npm run build && npm test",
    "publish:package": "npm publish --workspace=stark-lib",
    "pretest": "npm run build:package"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "turbo": "^2.11.9",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.4",
    "@typescript/native": "npm:typescript@^7.0.2"
  },
  "type": "module"
}
