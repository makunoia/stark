{
  "name": "stark-lib",
  "version": "0.2.0",
  "homepage": "http://makunoia.github.io/stark",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/makunoia/stark.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=24.11.0"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css",
    "./tailwind.plugin": {
      "types": "./dist/tailwind.plugin.d.ts",
      "default": "./dist/tailwind.plugin.js"
    },
    "./dist/tokens.css": "./dist/tokens.css",
    "./package.json": "./package.json",
    "./text": {
      "types": "./dist/types/text.d.ts",
      "import": "./dist/text.js",
      "require": "./dist/text.cjs"
    },
    "./text.css": "./dist/text.css"
  },
  "scripts": {
    "build": "node ../../scripts/build-library.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit --emitDeclarationOnly false",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0",
    "tailwindcss": "^4.3.3"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "imask": "^7.6.1",
    "lottie-react": "^3.1.2",
    "lucide-react": "^1.59.0",
    "motion": "^14.4.0",
    "quill": "^2.0.3",
    "remixicon": "^4.9.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3"
  }
}
